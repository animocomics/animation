# Serve Nomreh directly from its local production server, without Passenger.
# This file affects only this domain's public document root.
DirectoryIndex disabled

# Leave room for multipart/Base64 overhead; the app still enforces 100 MiB per file.
LimitRequestBody 157286400
RewriteEngine On
ProxyPreserveHost On

# Keep certificate renewal challenges on Apache.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# In per-directory context the root request has an empty path.
RewriteRule ^$ http://127.0.0.1:32147/ [P,L]
RewriteRule ^(.*)$ http://127.0.0.1:32147/$1 [P,L,QSA]
