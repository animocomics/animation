# Copy to .env.local before the first run and replace every example secret.
# Use a persistent absolute path in production.
NOMREH_DATA_DIR=./data

# Generate with: openssl rand -base64 48
NOMREH_SECRET_KEY=replace-with-a-long-random-encryption-secret

# Used only when the database is first initialized.
# On Cloudflare, set these as Worker Secrets instead of using .env files.
NOMREH_ADMIN_USERNAME=admin
NOMREH_ADMIN_PASSWORD=replace-with-a-strong-admin-password1
NOMREH_TEACHER_USERNAME=teacher
NOMREH_TEACHER_PASSWORD=replace-with-a-strong-teacher-password1
