# Copy to .env.local before the first run and replace every example secret.
# Use a persistent absolute path in production.
NOMREH_DATA_DIR=./data

# Generate with: openssl rand -base64 48
NOMREH_SECRET_KEY=replace-with-a-long-random-encryption-secret

# Used only when the database is first initialized.
NOMREH_ADMIN_USERNAME=admin
NOMREH_ADMIN_PASSWORD=replace-with-a-strong-admin-password1
NOMREH_TEACHER_USERNAME=teacher
NOMREH_TEACHER_PASSWORD=replace-with-a-strong-teacher-password1
NOMREH_COOKIE_SECURE=0  # legacy escape hatch; only for a plain-HTTP host. Leave unset when TLS is in front.
NOMREH_COOKIE_SAMESITE=none  # only when the app is shown inside a cross-site iframe (sandbox preview). Needs HTTPS.
NOMREH_HIDE_DEMO_ACCOUNTS=1  # set on a real deployment to hide the demo account cards

# --- Gemini behind a permitted egress (optional) -------------------------------
# Google refuses its API from an Iranian IP with "User location is not supported".
# A free Cloudflare Worker that forwards to generativelanguage.googleapis.com turns
# that refusal into a working call without any code change:
#   Cloudflare dashboard -> Workers & Pages -> Create -> Worker, deploy the relay,
#   then put its https://<name>.<account>.workers.dev address here.
# Leave it empty to talk to Google directly (the documented default).
# NOMREH_GEMINI_BASE_URL=https://gemini-relay.example.workers.dev

# How long one provider call may take. Answers must come back before the host's
# reverse proxy gives up, or the operator sees the proxy's error page instead.
# NOMREH_PROVIDER_TIMEOUT_MS=120000

# How many times one paid request may be re-sent. 1 = never (default): every
# attempt re-uploads the page images and is billed even when no answer comes back.
# NOMREH_PROVIDER_ATTEMPTS=1

# --- How much detail each page image carries --------------------------------
# Reading a sheet is a resolution problem before it is a model problem: a stacked
# fraction is a few pixels of ink, and at 2400 px the bar merges with the digits.
# 3000 px is the default. Raise to 3600 for dense handwriting; lower to 2400 only if
# requests are timing out. Measured cost of one A4 page at quality 88:
#   2400 px -> 106 KB   (not enough for stacked fractions on small print)
#   3000 px -> 147 KB   (default)
#   3600 px -> 158 KB
# NOMREH_PAGE_MAX_PX=3000
# NOMREH_PAGE_JPEG_QUALITY=88

# --- Long model calls no longer need a patient proxy -------------------------
# Reading a sheet and grading it now run as server-side jobs: the POST answers in
# milliseconds with a job id and the browser polls a tiny request for the result.
# That is what makes the host's ~60 second proxy limit harmless. Nothing to set here.
# If your host kills *background* work when the connection closes, raise the proxy
# timeout as well; the app works either way, but the poll is what matters.

# --- What Gemini actually gets to see, and how long it thinks -----------------
# Two different settings that are both mistaken for "it reads badly":
#   1. NOMREH_PAGE_MAX_PX (above) is how big the page image is.
#   2. This one is how much of that image Gemini is allowed to tokenise. On Gemini 3+
#      the default image budget is about 1120 tokens, which downscales a 3000 px scan
#      until a fraction bar or a subscript is gone.
# low (280) | medium (560) | high (1120, default) | ultra_high (2240, ~2x cost)
# NOMREH_GEMINI_MEDIA_RESOLUTION=high
#
# Reading a form is transcription, not reasoning. Dynamic thinking spends seconds
# before looking at the page. low = fastest (default); high = slower, more careful.
# NOMREH_GEMINI_THINKING=low

# --- How a big photo is delivered to the model -------------------------------
# A phone photo is ~9 megapixels; Gemini's image budget is under one, so the photo is
# shrunk to about 920 px before the model sees it and handwriting arrives unreadable.
# Oversized photos are therefore sent as several overlapping bands, each small enough
# to keep near full detail. This is the most important setting for handwriting.
#   NOMREH_IMAGE_PART_BUDGET_PX=1500000   (pixels per band; lower = more bands = more detail)
