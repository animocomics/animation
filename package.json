{
  "name": "nomreh-ai-grading",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-user Persian AI exam grading, class roster and gradebook platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:plesk": "next build && node scripts/compact-production.cjs",
    "compact:plesk": "node scripts/compact-production.cjs",
    "start": "next start -H 0.0.0.0",
    "start:plesk": "node scripts/plesk-standalone.cjs start",
    "restart:plesk": "node scripts/plesk-standalone.cjs restart",
    "stop:plesk": "node scripts/plesk-standalone.cjs stop",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@napi-rs/canvas": "0.1.100",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
