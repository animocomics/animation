{
  "name": "nomreh-ai-grading",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-user Persian AI exam grading, class roster and gradebook platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "build:plesk": "\"$npm_node_execpath\" scripts/plesk-node22.cjs build",
    "setup:plesk": "\"$npm_node_execpath\" scripts/plesk-node22.cjs setup",
    "compact:plesk": "\"$npm_node_execpath\" scripts/plesk-node22.cjs compact",
    "space:plesk": "\"$npm_node_execpath\" scripts/plesk-space.cjs",
    "git:compact": "node scripts/plesk-git-maintenance.cjs",
    "start": "next start -H 0.0.0.0",
    "start:plesk": "\"$npm_node_execpath\" scripts/plesk-standalone.cjs start",
    "restart:plesk": "\"$npm_node_execpath\" scripts/plesk-standalone.cjs restart",
    "stop:plesk": "\"$npm_node_execpath\" scripts/plesk-standalone.cjs stop",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "diagnose": "node scripts/nomreh-diagnose.cjs",
    "delta": "node scripts/nomreh-delta-update.cjs",
    "shecan:off": "node scripts/nomreh-disable-shecan.cjs",
    "shecan:on": "node scripts/nomreh-disable-shecan.cjs --on",
    "kaya:watch": "node scripts/kaya-reachability-watch.cjs",
    "kaya:check": "node scripts/kaya-reachability-watch.cjs --once",
    "kaya:diag": "node scripts/nomreh-kaya-diag.cjs",
    "kaya:test": "node scripts/nomreh-kaya-test.cjs",
    "kaya:measure": "node scripts/nomreh-kaya-measure.cjs",
    "kaya:selftest": "node scripts/nomreh-kaya-test-selftest.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@napi-rs/canvas": "0.1.100",
    "@napi-rs/canvas-linux-x64-gnu": "0.1.100",
    "@novnc/novnc": "file:vendor/novnc-novnc-1.7.0.tgz",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^6.29.1",
    "ws": "file:vendor/ws-8.22.1.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "file:vendor/next-swc-wasm-nodejs-16.4.3.tgz",
    "@esbuild/linux-x64": "0.28.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript-linux-x64": "7.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
